{
  "name": "@exidraw/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "exidraw web app (React + @excalidraw/excalidraw)",
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "mock": "tsx mock/server.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@exidraw/shared": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT"
}
